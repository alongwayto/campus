<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.device.dao.DeviceTypeMapper">

    <resultMap id="DeviceTypeResultMap" type="com.campus.device.model.entity.DeviceType">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="selectAll" resultMap="DeviceTypeResultMap">
        SELECT id, name, description, created_at
        FROM device_type
        ORDER BY id ASC
    </select>

    <select id="selectById" resultMap="DeviceTypeResultMap">
        SELECT id, name, description, created_at
        FROM device_type
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.campus.device.model.entity.DeviceType"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO device_type (name, description, created_at)
        VALUES (#{name}, #{description}, #{createdAt})
    </insert>

    <update id="update" parameterType="com.campus.device.model.entity.DeviceType">
        UPDATE device_type
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description}</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM device_type WHERE id = #{id}
    </delete>

</mapper>
